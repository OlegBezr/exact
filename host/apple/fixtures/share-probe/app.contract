// The share handler's device probe (LLP 1133.024 §20 stage 9, S0): an app
// with share_target.handle, whose handler makes one fetch. "Share a result"
// runs it (done); the next two shares are refused and opened; "Share the
// ramp" grows the extension to its limit. Copy this and app.ts into an app
// `exact new` made; the steps are in the stage's note.
shape Greeting
  text: string

routes nav
  home "/"
    share "/share"

component Shareprobe
  resource greeting = greeting("Share Probe") as shape Greeting
  state liked = false
  action like
    liked = not liked
  action shareResult
    share(text="Puzzle 0:39")
  action shareRefused
    share(text="refuse")
  action shareOpen
    share(text="open")
  action shareRamp
    share(text="exact-share-probe:ramp")
  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Share Probe" role="heading" aria-level=1 flex=1
            button press=like aria-label=(liked ? "Unlike" : "Like") testId="like"
              image (liked ? "symbol:heart-fill" : "symbol:heart")
          scroll id="content" flex=1 min-height=0 padding=16
            text (e.name == "share" ? `Opened with: ${searchParam(e, "text")}` : greeting.text) testId="greeting"
            button press=shareResult testId="share-result"
              text "Share a result"
            button press=shareRefused testId="share-refused"
              text "Share one the handler refuses"
            button press=shareOpen testId="share-open"
              text "Share one the handler opens"
            button press=shareRamp testId="share-ramp"
              text "Share the ramp"
